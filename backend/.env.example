# AI Drone Surveillance System - Backend Environment Configuration

# Server Binding (Never expose publicly by default)
HOST=127.0.0.1
PORT=8000
DEBUG=True

# CORS Configuration (Comma-separated origins for Vite/React frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./drone_surveillance.db

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv

# Camera & Source Security (Comma-separated webcam indices allowed)
ALLOWED_CAMERA_SOURCES=0,1

# Detector Selection ('mock' or 'yolo')
DETECTOR_TYPE=mock
YOLO_MODEL_PATH=

# Alert Rules & Thresholds
ALERT_CONFIDENCE_THRESHOLD=0.60
ALERT_CLASSES=human,car,drone

# Video Stream Configuration
STREAM_FPS=25
STREAM_JPEG_QUALITY=80
